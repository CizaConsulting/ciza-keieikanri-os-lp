---
// セルフチェック配布ページ（スクイーズページ）。
// 目的は「登録」ただ一つ。サービス説明・診断の売り込み・他ページへの回遊は置かない。
import SqueezeLayout from '../../layouts/SqueezeLayout.astro';
import KitCheckForm from '../../components/KitCheckForm.astro';
import { SITE_URL } from '../../lib/site';
import '../../styles/kit-form.css';

const title = '社長のためのバックオフィス・財務セルフチェック15問（無料PDF）｜CIZA Consulting';
const description = '社長が1週間休んだら、会社は回りますか。試算表・属人化・資金繰りの健康状態を3分で自己点検できる15問チェックリスト。3タイプの判定表つき無料PDF。';
---
<SqueezeLayout
  title={title}
  description={description}
  canonicalUrl={`${SITE_URL}/check`}
  ogImage={`${SITE_URL}/check/ogp.png`}
>

  <!-- ━━━ 1. ファーストビュー ━━━ -->
  <section class="hero"><div class="w hero-w">
    <div class="hero-copy">
      <div class="tag">3分でできる自己点検｜無料PDF</div>
      <h1>社長が1週間休んだら、<br class="br-sp">会社は回りますか。</h1>
      <p class="sub">試算表のスピード、業務の属人化、資金の見通し——中小企業のバックオフィス・財務の健康状態を、「はい／いいえ」の15問で自己点検できるチェックリストです。3タイプの判定表つき。</p>

      <div class="form-slot">
        <KitCheckForm />
      </div>
      <p class="form-note">ご登録後に届く確認メールのリンクから、PDFをダウンロードいただけます。月1回、経営管理の実務ニュースレターも配信します（ワンクリックで解除できます）。営業のお電話等は行いません。</p>
    </div>

    <div class="hero-visual">
      <img
        class="cover"
        src="/check/cover.png"
        alt="社長のためのバックオフィス・財務セルフチェック15問 PDFの誌面"
        width="1241"
        height="1754"
        loading="eager"
        decoding="async"
      >
    </div>
  </div></section>

  <!-- ━━━ 2. チラ見せ（3問だけ。15問全文は載せない） ━━━ -->
  <section class="sec sec-alt"><div class="w narrow">
    <h2>たとえば、こんな問いです</h2>
    <ul class="qlist">
      <li>月次試算表を、翌月15日までに見ている</li>
      <li>社長が1週間不在でも、請求と支払は止まらない</li>
      <li>3ヶ月先の預金残高を、だいたい言える</li>
    </ul>
    <p class="closing">すべて「はい」なら、このPDFは不要です。ひとつでも迷ったら、残りの12問がお役に立ちます。</p>
  </div></section>

  <!-- ━━━ 3. 何が分かるか ━━━ -->
  <section class="sec"><div class="w narrow">
    <h2>☑の数で、貴社のタイプが分かります</h2>
    <p class="body">15問は「A. 数字は経営に使えているか」「B. 会社は社長なしで回るか」「C. お金の備えはあるか」の3グループ。グループごとの☑の数から、貴社の弱点タイプ——数字が見えない型／社長集中型／資金の見通し不足型——を判定できます。</p>
    <p class="body note">チェックリストで分かるのは「症状」までですが、症状の自覚が、すべての改善の出発点です。</p>
  </div></section>

  <!-- ━━━ 4. 発行者情報（会社サイトへのリンクは張らない：回遊防止） ━━━ -->
  <section class="sec sec-alt"><div class="w narrow">
    <h2 class="h2-sm">発行者</h2>
    <p class="body">株式会社シザコンサルティング。元銀行員（商工中金）、コンサル歴17年。公認会計士パートナー在籍。中堅・中小企業の財務・経営管理支援を専門とし、自らもM&amp;Aで飲食事業を承継・経営しています。</p>
  </div></section>

  <!-- ━━━ 5. フォーム再掲 ━━━ -->
  <section class="sec sec-last"><div class="w narrow center">
    <h2>3分の自己点検から、始めませんか</h2>

    <div class="form-slot form-slot-center">
      <KitCheckForm />
    </div>
    <p class="form-note center-note">ご登録後に届く確認メールのリンクから、PDFをダウンロードいただけます。月1回、経営管理の実務ニュースレターも配信します（ワンクリックで解除できます）。営業のお電話等は行いません。</p>
  </div></section>

  {/* Kit の送信処理。フォームは2箇所あるが、この読み込みは1回でよい */}
  <script is:inline async src="https://f.convertkit.com/ckjs/ck.5.js"></script>

  <style>
    .w.narrow{max-width:720px;}
    .center{text-align:center;}

    /* 1. ファーストビュー */
    .hero{padding:104px 0 56px;}
    .hero-w{display:grid;grid-template-columns:1.15fr .85fr;gap:48px;align-items:center;}
    .tag{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.04em;color:var(--accent2);background:var(--accent-soft);border:1px solid rgba(148,199,76,.2);border-radius:999px;padding:6px 14px;margin-bottom:18px;}
    .hero h1{font-family:'Zen Kaku Gothic New','Noto Sans JP','Meiryo',sans-serif;font-size:clamp(27px,4.2vw,44px);font-weight:900;line-height:1.4;letter-spacing:-.02em;}
    .sub{margin-top:18px;font-size:16px;line-height:1.95;color:var(--ink2);}
    .form-note{margin-top:12px;font-size:12.5px;line-height:1.8;color:var(--muted);}

    .form-slot{margin-top:26px;}
    .form-slot-center{display:flex;justify-content:center;}
    .btn-lg{font-size:16px;padding:16px 34px;width:100%;max-width:400px;}

    .hero-visual{display:flex;justify-content:center;}
    .cover{width:100%;height:auto;max-width:300px;border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-lg);}

    /* 2〜5. 共通 */
    .sec{padding:56px 0;}
    .sec-alt{background:var(--bg2);}
    .sec-last{padding:60px 0 72px;}
    .sec h2{font-family:'Zen Kaku Gothic New','Noto Sans JP','Meiryo',sans-serif;font-size:clamp(20px,2.8vw,27px);font-weight:900;line-height:1.5;letter-spacing:-.01em;}
    .sec .h2-sm{font-size:clamp(17px,2vw,20px);}
    .body{margin-top:16px;font-size:15.5px;line-height:2;color:var(--ink2);}
    .body.note{margin-top:14px;font-size:14.5px;color:var(--muted);}

    .qlist{list-style:none;margin-top:22px;display:grid;gap:12px;}
    .qlist li{position:relative;padding:15px 18px 15px 50px;background:#fff;border:1px solid var(--border);border-radius:var(--radius);font-size:15.5px;line-height:1.7;color:var(--ink2);box-shadow:var(--shadow-sm);}
    .qlist li::before{content:'';position:absolute;left:18px;top:50%;transform:translateY(-50%);width:19px;height:19px;border:2px solid var(--border2);border-radius:5px;background:#fff;}
    .closing{margin-top:20px;font-size:15px;line-height:1.95;color:var(--ink2);font-weight:700;}

    /* スマホで3スクロール以内に収めるため、モバイルでは余白と表紙を詰める。
       フォームが2箇所入るぶん、ここを緩めると簡単に3スクロールを超える。 */
    @media(max-width:880px){
      .hero{padding:84px 0 28px;}
      .hero-w{grid-template-columns:1fr;gap:20px;}
      .hero-visual{order:-1;}
      .cover{max-width:140px;}
      .btn-lg{max-width:none;}
      .sec{padding:30px 0;}
      .sec-last{padding:32px 0 40px;}
      .sub{margin-top:14px;font-size:15px;line-height:1.85;}
      .form-slot{margin-top:20px;}
      .form-note{margin-top:10px;}
      .body{margin-top:12px;font-size:15px;line-height:1.9;}
      .qlist{margin-top:16px;gap:8px;}
      .qlist li{font-size:14.5px;padding:12px 16px 12px 44px;}
      .closing{margin-top:16px;}
    }
    @media(min-width:481px){.br-sp{display:none;}}
  </style>
</SqueezeLayout>
