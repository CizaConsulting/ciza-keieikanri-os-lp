---
// スクイーズページ専用レイアウト。
// 目的は登録のみ。回遊させないため、ヘッダーはロゴだけ・ナビリンクなし、
// フッターは会社概要とプライバシーポリシーだけに絞っている。
// デザイントークンは他ページと同一（新しい見た目を足さない）。
import { COMPANY_NAME, COMPANY_NAME_EN, SITE_URL, CORP_URL } from '../lib/site';
// 素の CSS として読み込む。.astro の <style> だとこのレイアウトの要素にしかかからず、
// ページ側の .w や .btn に届かない（コンテナが効かず左寄せになる）。
import '../styles/squeeze-base.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = `${SITE_URL}/ogp.png`,
  noindex = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="format-detection" content="telephone=no">
<meta name="theme-color" content="#0b0b0c">
{noindex
  ? <meta name="robots" content="noindex,nofollow">
  : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1">}
<meta name="google-site-verification" content="oi3EijtDqMuQZSVLIzbIRHA9ZfDSAIr4C-ifUkxbESA" />

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B38CWGT60C"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-B38CWGT60C');
</script>

<meta name="author" content={COMPANY_NAME}>
<link rel="canonical" href={canonicalUrl}>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230e0e10'/%3E%3Ctext x='32' y='42' font-family='Arial,sans-serif' font-size='30' font-weight='900' fill='%2394c74c' text-anchor='middle'%3EC%3C/text%3E%3C/svg%3E">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={COMPANY_NAME}>
<meta property="og:locale" content="ja_JP">
<meta property="og:url" content={canonicalUrl}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:type" content="image/png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap" rel="stylesheet">
</head>
<body>

<nav class="nav"><div class="w">
  <div class="nav-brand">
    <div class="mark">C</div>
    <div class="brand-text">CIZA<small>経営管理OS</small></div>
  </div>
</div></nav>

<slot />

<footer><div class="w footer">
  <div class="footer-nav">
    <a href={`${CORP_URL}/company.html`} target="_blank" rel="noopener noreferrer">会社概要</a>
    <a href="/privacy">プライバシーポリシー</a>
  </div>
  <small>&copy; 2026 {COMPANY_NAME_EN}</small>
</div></footer>

</body>
</html>
